# AIHOT 资讯平台 · 环境变量示例
# 复制为 .env 后按需修改（服务端使用 python-dotenv 风格的变量；本代理通过 os.environ 读取）
# 说明：server/server.py 直接读取系统环境变量；以下变量均可不设置（使用默认值）。

# AIHOT 匿名只读 v1 API 上游域名（仅转发，不落库、不改写）
AIHOT_UPSTREAM=https://aihot.virxact.com
AIHOT_API_PREFIX=/api/v1

# 代理服务监听
HOST=0.0.0.0
PORT=8000

# 缓存与限流（依据 AIHOT 调用规约：同端点轮询间隔 ≥ 60s）
AIHOT_MIN_POLL_INTERVAL=60
AIHOT_CACHE_TTL=300

# 菜单（菜单栏）组合结果缓存时长（秒）；菜单为低频数据，默认 3600s
MENU_CACHE_TTL=3600

# 上游要求的 User-Agent（无 .aihot-actor-id 时使用基础标识）
AIHOT_USER_AGENT=aihot-skill/1.5.4 (+https://aihot.virxact.com/aihot-skill/)

# ═══════════════════════════════════════════════════════
# GitHub Actions 部署所需 Secrets（在仓库 Settings 中配置）
# ═══════════════════════════════════════════════════════
# Secrets:
#   ALIBABA_CLOUD_ACCESS_KEY_ID      阿里云 AK（FC + ESA CLI 共用）
#   ALIBABA_CLOUD_ACCESS_KEY_SECRET  阿里云 SK（FC + ESA CLI 共用）
#
# Variables:
#   AIHOT_UPSTREAM  AIHOT 上游地址（可选，默认 https://aihot.virxact.com）
#
# 注意：ESA Pages 部署使用 esa-cli，通过 ESA_ACCESS_KEY_ID / ESA_ACCESS_KEY_SECRET
#       环境变量认证（已在 deploy.yml 中映射为 ALIBABA_CLOUD_ACCESS_KEY_*）
